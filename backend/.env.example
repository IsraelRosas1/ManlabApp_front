# =====================================================================
# ManLab App — Variables de entorno (backend)
# Copiar a .env y rellenar. NADA de secrets en el frontend.
# La key del LLM NUNCA viaja al cliente.
# =====================================================================

# ---- App ----
NODE_ENV=production
PORT=8080
WEB_BASE_URL=https://manlabproject.com          # donde se cobra (Stripe)
APP_BASE_URL=https://app.manlabproject.com       # la PWA
JWT_SECRET=                                       # generar 256-bit aleatorio
JWT_EXPIRES_IN=30d
MAGIC_LINK_SECRET=                                # firma de tokens magic link
MAGIC_LINK_TTL_MIN=15

# ---- Base de datos (Supabase o Neon) ----
DATABASE_URL=postgresql://user:pass@host:5432/manlab

# ---- Stripe (cobro en web) ----
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...                   # verificación de firma del webhook
STRIPE_PRICE_MENSUAL=price_...                    # crear en Stripe; mapear a plan_config
STRIPE_PRICE_ANUAL=price_...
STRIPE_PRICE_FUNDADOR=price_...

# ---- LLM (Veredicto del Clon — el MOAT) ----
LLM_PROVIDER=anthropic                            # 'anthropic' | 'openai'
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6
OPENAI_API_KEY=                                   # solo si LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4.1
VERDICT_MAX_TOKENS=400                            # veredicto breve (4–8 líneas)
VERDICT_TEMPERATURE=0.6                           # baja-media

# ---- Delphi (Clon conversacional, embed) ----
DELPHI_EMBED_URL=https://embed.delphi.ai/manlab   # confirmar con Brand Kit Scaler
DELPHI_EMBED_ORIGIN=https://embed.delphi.ai

# ---- Hosting de video protegido (Bunny Stream o Mux) ----
VIDEO_PROVIDER=bunny                              # 'bunny' | 'mux'
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=
BUNNY_TOKEN_SIGNING_KEY=                          # para signed URLs
# --- alternativa Mux ---
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_SIGNING_KEY_ID=
MUX_SIGNING_PRIVATE_KEY=

# ---- Storage protegido (EPUB + audio) ----
STORAGE_PROVIDER=supabase                         # supabase | s3
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
STORAGE_BUCKET_BOOKS=manlab-books
STORAGE_BUCKET_AUDIO=manlab-audio
SIGNED_URL_TTL_SEC=3600

# ---- Push (OneSignal) ----
ONESIGNAL_APP_ID=
ONESIGNAL_API_KEY=

# ---- Email transaccional + dunning + win-back (Brevo) ----
BREVO_API_KEY=
BREVO_SENDER_EMAIL=no-reply@manlabproject.com
BREVO_SENDER_NAME=ManLab
BREVO_LIST_WINBACK_ID=                            # lista de los 1,979 expirados
BREVO_TEMPLATE_ACCESS_READY=                      # "Tu acceso a la app está listo"
BREVO_TEMPLATE_DUNNING_1=                         # recobro inmediato (fallo sorpresivo)
BREVO_TEMPLATE_EXPIRY_7D=                         # aviso 7 días (anual/Wise/USDT)
BREVO_TEMPLATE_EXPIRY_3D=                         # aviso 3 días
BREVO_TEMPLATE_PASSWORD_RESET=

# ---- YouTube (push automático de video nuevo) ----
YOUTUBE_CHANNEL_ID=
YOUTUBE_API_KEY=

# ---- Cron / jobs nocturnos ----
CRON_SECRET=                                       # protege el endpoint del job nocturno
TZ=America/Cancun                                  # zona para el corte "al cierre del día"

# ---- Observabilidad ----
SENTRY_DSN=
