{
  "name": "manlab-app-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Backend ManLab App — Auth, entitlements (Stripe), Reto engine, Veredicto (LLM), admin, webhooks.",
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "db:schema": "psql \"$DATABASE_URL\" -f ../db/schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.30.0",
    "express": "^4.19.2",
    "stripe": "^16.0.0",
    "pg": "^8.12.0",
    "jsonwebtoken": "^9.0.2",
    "bcryptjs": "^2.4.3",
    "zod": "^3.23.8",
    "dotenv": "^16.4.5",
    "@onesignal/node-onesignal": "^5.0.0",
    "@getbrevo/brevo": "^2.2.0"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "tsx": "^4.16.0",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/bcryptjs": "^2.4.6",
    "@types/pg": "^8.11.6"
  }
}
